# ---------------------------------------------------------------------------
# Agentic OS configuration
# Copy to .env.local and edit. .env.local is git-ignored and must never be
# committed: it contains machine-specific paths and, optionally, an API key.
# ---------------------------------------------------------------------------

# Absolute path to the Obsidian vault that acts as the single knowledge root.
# The application reads all of it and writes ONLY inside <VAULT_ROOT>/Agentic OS.
# Windows example: C:\Users\YourName\Documents\MyVault
# macOS / Linux example: /Users/yourname/Documents/MyVault
VAULT_ROOT=

# Folder inside the vault the application may create and modify freely.
MANAGED_FOLDER=Agentic OS

# Hidden folder inside the vault holding database, logs, backups, originals.
INTERNAL_FOLDER=.agentic-os

# ---------------------------------------------------------------------------
# AI configuration - OFF BY DEFAULT
# ---------------------------------------------------------------------------
# Leave AI_ENABLED=false to run the entire product with zero token usage.
# Nothing is sent anywhere while this is false, regardless of other settings.
AI_ENABLED=false

# Only read when AI_ENABLED=true. Without it the NoOp provider is used.
ANTHROPIC_API_KEY=

# Model used for Token Class 1-2 work (classification, short summaries).
AI_MODEL_FAST=claude-haiku-4-5-20251001

# Model used for Token Class 3 work (synthesis, contradiction analysis).
AI_MODEL_DEEP=claude-sonnet-5

# Hard ceiling in US dollars per calendar month. Jobs stop when reached.
AI_MONTHLY_BUDGET_USD=5.00

# Hard ceiling on input tokens for any single analysis run.
AI_PER_RUN_TOKEN_CEILING=30000
